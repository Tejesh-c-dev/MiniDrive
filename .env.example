POSTGRES_DB=minidrive
POSTGRES_USER=minidrive
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://127.0.0.1:55432/minidrive
DB_USERNAME=minidrive
DB_PASSWORD=change-me


JWT_SECRET=change-this-development-secret-key-to-at-least-32-characters

# MinIO object storage (Phase 4)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=minidrive-files

# Optional second Silo node. Enable it after starting the second Compose service.
MINIO_PRIMARY_ENABLED=true
MINIO_SECONDARY_ENABLED=false
MINIO_SECONDARY_ENDPOINT=http://localhost:9100
MINIO_SECONDARY_ACCESS_KEY=minioadmin
MINIO_SECONDARY_SECRET_KEY=change-me-secondary-silo-password
MINIO_SECONDARY_BUCKET=minidrive-files-secondary
MINIO_SECONDARY_ROOT_USER=minioadmin
MINIO_SECONDARY_ROOT_PASSWORD=change-me-secondary-silo-password

# Redis cache (Phase 10). Host-run backend defaults to the Compose-published
# loopback port; inside Compose use host "redis" port 6379 instead.
REDIS_HOST=localhost
REDIS_PORT=56379
