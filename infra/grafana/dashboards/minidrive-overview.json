      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(http_server_requests_seconds_count{job=\"minidrive\"}[5m]))", "legendFormat": "Requests / second", "range": true, "refId": "A" }],
