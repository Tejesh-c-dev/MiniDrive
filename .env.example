POSTGRES_DB=minidrive
POSTGRES_USER=minidrive
POSTGRES_PASSWORD=change-me
# Local monitoring only. Create the minidrive_exporter role with
# infra/monitoring/setup-postgres-exporter.ps1 before enabling that exporter.
POSTGRES_EXPORTER_PASSWORD=change-me-monitoring-password

DB_URL=jdbc:postgresql://127.0.0.1:55432/minidrive
DB_USERNAME=minidrive
DB_PASSWORD=change-me


JWT_SECRET=change-this-development-secret-key-to-at-least-32-characters

# Local-only MinIO credentials. Never reuse these values in a deployment.
MINIO_ROOT_USER=local_minio_user
MINIO_ROOT_PASSWORD=local_only_minio_root_2026
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=local_minio_user
MINIO_SECRET_KEY=local_only_minio_root_2026
MINIO_BUCKET=minidrive-files
MINIDRIVE_CLEANUP_JOURNAL_DIR=./data/cleanup-journal

# Optional second Silo node. Enable it after starting the second Compose service.
MINIO_PRIMARY_ENABLED=true
MINIO_SECONDARY_ENABLED=false
MINIO_SECONDARY_ENDPOINT=http://localhost:9100
MINIO_SECONDARY_ACCESS_KEY=local_secondary_user
MINIO_SECONDARY_SECRET_KEY=local_only_secondary_minio_2026
MINIO_SECONDARY_BUCKET=minidrive-files-secondary
MINIO_SECONDARY_ROOT_USER=local_secondary_user
MINIO_SECONDARY_ROOT_PASSWORD=local_only_secondary_minio_2026

# Replication is opt-in. The primary remains the sole write authority.
MINIDRIVE_REPLICATION_ENABLED=false
MINIDRIVE_REPLICATION_BACKFILL=false
MINIDRIVE_PRIMARY_NODE_ID=primary
MINIDRIVE_REPAIR_DELAY_MS=30000

# Redis cache (Phase 10). Host-run backend defaults to the Compose-published
# loopback port; inside Compose use host "redis" port 6379 instead.
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_USERNAME=minidrive_app
REDIS_PASSWORD=local_only_redis_app_2026
REDIS_EXPORTER_USERNAME=minidrive_exporter
REDIS_EXPORTER_PASSWORD=local_only_redis_exporter_2026
