      "targets": [{ "editorMode": "code", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"minidrive\"}[5m]))", "legendFormat": "HTTP {{status}}", "range": true, "refId": "A" }],
      "title": "HTTP response status distribution",
      "type": "timeseries"
    }
