    {
      "datasource": { "type": "prometheus", "uid": "minidrive-prometheus" },
      "description": "1 means Prometheus can scrape MiniDrive; 0 means the scrape is failing.",
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "up{job=\"minidrive\"}", "legendFormat": "MiniDrive scrape", "range": true, "refId": "A" }],
      "title": "MiniDrive scrape availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "minidrive-prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "jvm_memory_used_bytes{area=\"heap\",job=\"minidrive\"}", "legendFormat": "{{id}} used", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "jvm_memory_max_bytes{area=\"heap\",job=\"minidrive\"}", "legendFormat": "{{id}} max", "range": true, "refId": "B" }
      ],
      "title": "JVM heap memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "minidrive-prometheus" },
